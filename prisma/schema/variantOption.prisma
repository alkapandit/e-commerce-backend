model VariantOption {
  id        Int @id @default(autoincrement())
  variantId Int @map("variant_id")

  value String // e.g. "M", "Red"
  price Decimal? @db.Decimal(10, 2)
  stock Int?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  cartItems CartItem[]

  @@map("variant_options")
}
